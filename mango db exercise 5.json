// Challenge: Find Top Scoring Courses (with Threshold)

db.student_scores.aggregate([
    {
        $match: {
            score: { $gt: 85 }
        }
    },
    {
        $group: {
            _id: "$course_name",
            top_performers: { $sum: 1 }
        }
    },
    {
        $sort: {
            top_performers: -1
        }
    },
    {
        $project: {
            _id: 0,
            course_name: "$_id",
            top_performers: 1
        }
    }
]);